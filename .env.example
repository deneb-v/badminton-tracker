# docker compose settings — copy to .env (which is git-ignored) and fill in.

# Port the app is published on: http://localhost:8080
APP_PORT=8080

# Required: signs login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Database. Default: a MySQL on this machine (e.g. the existing `mysql` container on :3306).
# With `docker compose --profile db up`, use DB_HOST=db (and pick a real DB_PASSWORD).
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=badminton
DB_PASSWORD=badminton
DB_NAME=badminton_tracker
